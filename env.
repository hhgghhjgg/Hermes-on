# ============================================================
# Hermes + WebUI Deployment - Environment Variables (TEMPLATE)
# ============================================================
# 1) Copy this file to `.env`  ->  cp env.example. env.
# 2) Fill in the values below.
# 3) On Render, add these SAME keys/values in the
#    "Environment Variables" section of your Web Service.
# ============================================================

# ------------------------------------------------------------
# GITHUB SYNC  (required for persistence on Render free plan)
# ------------------------------------------------------------
# Personal Access Token with `repo` scope.
# Create it: GitHub -> Settings -> Developer settings ->
#            Personal access tokens -> Tokens (classic) -> Generate
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The PRIVATE repo that will store Hermes data (sessions, skills, config).
# Format: <your-username>/<repo-name>   (NO https://, NO .git)
# Example: GITHUB_REPO=alihermes/hermes-data
GITHUB_REPO=yourusername/hermes-data

# How often (seconds) the sync.sh script pushes changes to GitHub.
# 180 = every 3 minutes. Lower = safer but more git commits.
SYNC_INTERVAL=180

# ------------------------------------------------------------
# WEBUI SECURITY  (REQUIRED when exposed on the internet)
# ------------------------------------------------------------
# Password to log into the WebUI. Pick a STRONG value.
# Without this, anyone with your Render URL can use your agent.
HERMES_WEBUI_PASSWORD=ChangeMe_Str0ng_P@ssw0rd!

# ------------------------------------------------------------
# WEBUI NETWORK
# ------------------------------------------------------------
# Bind address. Keep 0.0.0.0 so Render can route traffic to it.
HERMES_WEBUI_HOST=0.0.0.0

# Port the WebUI listens on. Must match Render's "Port" setting.
HERMES_WEBUI_PORT=8787

# ------------------------------------------------------------
# HERMES PATHS  (usually leave as default - set by Dockerfile)
# ------------------------------------------------------------
# Base directory for all Hermes state.
HERMES_HOME=/data/.hermes

# Where WebUI stores sessions/settings.
HERMES_WEBUI_STATE_DIR=/data/.hermes/webui

# Location of the cloned hermes-agent source.
HERMES_WEBUI_AGENT_DIR=/app/hermes-agent

# ------------------------------------------------------------
# 🔥 OMNIROUTE CONFIGURATION (NEW - replaces Qwen Proxy)
# ------------------------------------------------------------
# The URL of your OmniRoute Render service.
# This is the PUBLIC URL that Render gives your OmniRoute service.
# Format: https://<your-omniroute-service-name>.onrender.com
# NO trailing slash, NO /v1 suffix (entrypoint.sh adds it)
OMNIROUTE_URL=https://omniroute-app.onrender.com

# Model to use through OmniRoute.
# "auto" = OmniRoute picks the best available provider automatically
# You can also specify a specific model like:
#   - auto/coding    (quality-first for code generation)
#   - auto/fast      (lowest latency)
#   - auto/cheap     (cheapest per token)
#   - deepseek/deepseek-chat  (specific model)
#   - kimi/kimi-k3            (specific model)
HERMES_WEBUI_DEFAULT_MODEL=auto

# ------------------------------------------------------------
# LLM PROVIDER KEYS  (OPTIONAL - only if you want direct access)
# ------------------------------------------------------------
# These are NOT needed when using OmniRoute!
# OmniRoute handles all provider authentication.
# Only set these if you want Hermes to bypass OmniRoute
# and talk directly to a specific provider.
#
# GEMINI_API_KEY=your-google-ai-studio-key-here
# GOOGLE_API_KEY=your-google-ai-studio-key-here
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_API_KEY=xxxxxxxxxxxxxxxx

# ============================================================
# END OF TEMPLATE
